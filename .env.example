# Copier en .env pour le développement local, ou saisir dans Vercel
# (Settings → Environment Variables). Toutes facultatives : sans elles, le site
# fonctionne, et les formulaires laissent place aux moyens de contact directs.

# Facultatif : l’adresse publique (https://autoecoleliberte.fr). Sans elle, le site
# prend le domaine de production du projet Vercel. Il s’ouvre à Google dès qu’il a
# un vrai domaine (rattaché à Vercel, ou indiqué ici) ; sur *.vercel.app, « noindex ».
SITE_URL=

# Service d’envoi des demandes : resend ou brevo
EMAIL_PROVIDER=resend
RESEND_API_KEY=
BREVO_API_KEY=
# L’adresse qui reçoit les demandes
CONTACT_TO=ae.liberte@gmail.com
# L’adresse d’expédition, sur le domaine vérifié chez Resend. Aucune boîte à créer :
# les demandes arrivent sur CONTACT_TO, et « Répondre » écrit au demandeur.
CONTACT_FROM=Auto-Moto École Liberté <devis@autoecoleliberte.fr>
# 32 caractères au moins : openssl rand -hex 32
FORM_SECRET=
