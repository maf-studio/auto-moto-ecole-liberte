---
import type { Visuel } from '../../data/formations.ts'
import Icone, { type NomIcone } from './Icone.astro'

/**
 * Le visuel d’une formation sans photographie, dans le style du flyer : le
 * gris des pages et ses reflets en diagonale, la pastille turquoise à liseré
 * pointillé et son pictogramme blanc, la ligne de route en pointillés.
 * Purement décoratif (`aria-hidden`).
 */
interface Props {
  motif: Visuel
  class?: string
}

const { motif, class: classe } = Astro.props

const ICONE: Record<Visuel, NomIcone | null> = {
  panneau: null,
  voiture: 'voiture',
  automatique: null,
  duo: 'utilisateurs',
  manuelle: 'vitesses',
  moto: 'moto',
  scooter: 'moto',
}
const icone = ICONE[motif]
---

<div class:list={['visuel', classe]} aria-hidden="true">
  <span class="visuel__reflet"></span>
  <span class="pastille visuel__pastille">
    {
      motif === 'panneau' ? (
        <svg viewBox="0 0 24 24" class="visuel__triangle">
          <path d="M12 3 22 20H2Z" />
          <path d="M12 9.5v5M12 17.2v.3" />
        </svg>
      ) : motif === 'automatique' ? (
        <span class="visuel__lettres">
          <span>P</span>
          <span>R</span>
          <span>N</span>
          <span>D</span>
        </span>
      ) : (
        icone && <Icone nom={icone} />
      )
    }
  </span>
  <span class="visuel__route ligne-route"></span>
</div>

<style>
  .visuel {
    position: relative;
    display: grid;
    place-items: center;
    overflow: hidden;
    background: var(--gris);
    isolation: isolate;
  }

  .visuel__reflet {
    position: absolute;
    inset: -10% auto -10% 52%;
    width: 22%;
    background: rgb(255 255 255 / 0.4);
    transform: skewX(var(--biais));
    z-index: -1;
  }

  .visuel__pastille {
    --taille: min(40%, 8.5rem);
    margin-block-end: 6%;
  }

  .visuel__pastille :global(svg) {
    stroke-width: 1.8;
  }

  .visuel__route {
    position: absolute;
    inset-inline: 8%;
    inset-block-end: 13%;
    color: var(--noir);
    opacity: 0.55;
  }

  .visuel__triangle path {
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  .visuel__lettres {
    position: relative;
    display: flex;
    gap: 0.08em;
    font-family: var(--police-titre);
    font-size: clamp(1.1rem, 2.2vw, 1.55rem);
    font-weight: 800;
    color: var(--blanc);
  }
</style>
