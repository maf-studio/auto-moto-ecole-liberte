---
import Base from '../layouts/Base.astro'
import AppelFinal from '../components/sections/AppelFinal.astro'
import HerosPage from '../components/sections/HerosPage.astro'
import CarteFormule from '../components/tarifs/CarteFormule.astro'
import EnteteSection from '../components/ui/EnteteSection.astro'
import Icone from '../components/ui/Icone.astro'
import { ETABLISSEMENT } from '../data/etablissement.ts'
import { formation } from '../data/formations.ts'
import { AUTRES_FORMATIONS, DEFINITION_LECON, GROUPES_TARIFS, PRESTATIONS_A_LA_CARTE } from '../data/tarifs.ts'
import { euros } from '../lib/format.ts'

/**
 * Les tarifs, dans l’ordre et la présentation du flyer : formules permis B,
 * formules permis moto, autres formations, prestations à la carte. Les prix
 * viennent de `formations.ts` et de `tarifs.ts` ; modifier un prix = modifier
 * la donnée, jamais cette page.
 */
const filAriane = [
  { libelle: 'Accueil', href: '/' },
  { libelle: 'Tarifs et devis', href: '/tarifs' },
]

const groupes = GROUPES_TARIFS.map((g) => ({
  titre: g.titre,
  formules: g.formules.map(({ formation: slug, rang }) => {
    const f = formation(slug)
    return { formule: f.formules[rang], lien: f.statut === 'publiee' ? `/${f.slug}` : null }
  }),
}))
---

<Base
  titre="Tarifs auto-école aux Lilas : formules et devis"
  description="Les formules et tarifs TTC de l’Auto-Moto École Liberté aux Lilas : permis B, boîte automatique, conduite accompagnée, permis moto, passerelles, leçons à la carte."
  filAriane={filAriane}
>
  <HerosPage filAriane={filAriane} surTitre="Tarifs et devis">
    <Fragment slot="titre">Nos formules <span class="accent">et tarifs</span></Fragment>
    Des forfaits complets, du dossier jusqu’à l’examen, et des leçons à la carte. Tous nos tarifs sont indiqués TTC ;
    le devis s’ajuste au nombre de leçons estimé lors de l’évaluation de départ.
    <Fragment slot="actions">
      <a class="bouton bouton--clair" href="/contact#demande">
        Obtenir un devis personnalisé <Icone nom="fleche" />
      </a>
      <a class="bouton bouton--contour-clair" href={ETABLISSEMENT.telephone.lien}>
        <Icone nom="telephone" /> Nous appeler
      </a>
    </Fragment>
  </HerosPage>

  <div class="section section--gris tarifs">
    <div class="conteneur">
      {
        groupes.map((g, i) => (
          <section class="groupe" aria-labelledby={`groupe-${i}`}>
            <h2 id={`groupe-${i}`} class="bandeau-titre">
              {g.titre}
            </h2>
            <div class:list={['groupe__formules', `groupe__formules--${g.formules.length}`]}>
              {g.formules.map(({ formule, lien }) => (
                <CarteFormule formule={formule} lien={lien} />
              ))}
            </div>
          </section>
        ))
      }

      <section class="groupe" aria-labelledby="groupe-autres">
        <h2 id="groupe-autres" class="bandeau-titre">Autres formations</h2>
        <ul class="autres">
          {
            AUTRES_FORMATIONS.map((a) => (
              <li class="autre">
                <h3 class="autre__titre">
                  {a.formation ? <a href={`/${a.formation}`}>{a.titre}</a> : a.titre}
                </h3>
                <p class="barre-prix">
                  <span class="barre-prix__libelle">{a.detail}</span>
                  <span class="barre-prix__montant">
                    {a.supplement ? '+ ' : ''}
                    {euros(a.prixTTC)}
                    <span class="barre-prix__ttc">TTC</span>
                  </span>
                </p>
              </li>
            ))
          }
        </ul>
        <p class="tarifs__note">
          Conduite supervisée : tarif sur demande. Le forfait code (6 mois) est compris dans chaque formule ; le code
          seul se prend à la carte (pack web, livre de code). Plus de détails sur nos formations sont disponibles à
          l’agence.
        </p>
      </section>

      <section class="groupe" aria-labelledby="groupe-carte">
        <h2 id="groupe-carte" class="bandeau-titre">Prestations à la carte</h2>
        <div class="table-defile" tabindex="0" role="region" aria-labelledby="groupe-carte">
          <table class="carte-prix">
            <thead>
              <tr>
                <th scope="col">Prestation</th>
                <th scope="col">
                  <span class="carte-prix__boite">
                    <Icone nom="vitesses" /> Boîte manuelle
                  </span>
                </th>
                <th scope="col">
                  <span class="carte-prix__boite">
                    <span class="carte-prix__prnd" aria-hidden="true">PRND</span> Boîte automatique
                  </span>
                </th>
              </tr>
            </thead>
            <tbody>
              {
                PRESTATIONS_A_LA_CARTE.map((p) => (
                  <tr>
                    <th scope="row">{p.libelle}</th>
                    {'prix' in p ? (
                      <td colspan="2" class="carte-prix__prix">
                        {euros(p.prix)}
                      </td>
                    ) : (
                      <>
                        <td class="carte-prix__prix">{euros(p.manuelle)}</td>
                        <td class="carte-prix__prix">{euros(p.automatique)}</td>
                      </>
                    )}
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <p class="tarifs__note">
          <strong>{DEFINITION_LECON}</strong> Tous nos tarifs sont indiqués TTC.
        </p>
      </section>
    </div>
  </div>

  <section class="section" aria-labelledby="titre-prix">
    <div class="conteneur">
      <EnteteSection etiquette="Bon à savoir" id="titre-prix">
        <Fragment slot="titre">Ce qui fait <span class="accent">varier le prix</span></Fragment>
      </EnteteSection>
      <ul class="explications">
        <li>
          <span class="pastille explications__pastille" aria-hidden="true"><Icone nom="volant" /></span>
          <h3>L’évaluation de départ</h3>
          <p>Obligatoire avant la formation pratique, elle estime le nombre de leçons adapté à votre profil.</p>
        </li>
        <li>
          <span class="pastille explications__pastille" aria-hidden="true"><Icone nom="horloge" /></span>
          <h3>Le nombre de leçons</h3>
          <p>La loi fixe un minimum (20 heures en boîte manuelle, 13 en automatique) ; chacun avance à son rythme.</p>
        </li>
        <li>
          <span class="pastille explications__pastille" aria-hidden="true"><Icone nom="vitesses" /></span>
          <h3>La boîte de vitesses</h3>
          <p>Boîte manuelle ou automatique : le minimum de leçons, et donc le budget, ne sont pas les mêmes.</p>
        </li>
        <li>
          <span class="pastille explications__pastille" aria-hidden="true"><Icone nom="tirelire" /></span>
          <h3>Le financement</h3>
          <p>Paiement en 3 fois sans frais, permis à 1 € par jour, CPF selon votre situation.</p>
          <a class="lien-fleche" href="/financement">Les solutions <Icone nom="fleche" /></a>
        </li>
      </ul>
    </div>
  </section>

  <AppelFinal titre="Votre devis," accent="sans attendre" texte="Dites-nous quelle formation vous intéresse : nous établissons un devis détaillé, prix TTC." />
</Base>

<style>
  .groupe + .groupe {
    margin-block-start: clamp(3rem, 2rem + 3vw, 5rem);
  }

  .bandeau-titre {
    margin-block-end: var(--e-6);
  }

  .groupe__formules {
    display: grid;
    gap: var(--e-5);
    align-items: start;
  }

  .autres {
    display: grid;
    gap: var(--e-4);
    list-style: none;
  }

  .autre {
    display: grid;
    gap: var(--e-3);
    align-content: start;
    padding: var(--e-5);
    border-radius: var(--rayon-l);
    background: var(--gris-carte);
  }

  .autre__titre {
    font-size: clamp(1.5rem, 1.3rem + 0.7vw, 1.9rem);
  }

  .autre__titre a {
    color: var(--encre);
    text-decoration-color: var(--petrole);
  }

  .tarifs__note {
    max-width: var(--largeur-texte);
    margin-block-start: var(--e-5);
    color: var(--texte-doux);
  }

  .tarifs__note strong {
    color: var(--encre);
    font-weight: 600;
  }

  /* La table « prestations à la carte » du flyer : lignes claires et noires. */
  .table-defile {
    overflow-x: auto;
    border-radius: var(--rayon);
  }

  .carte-prix {
    width: 100%;
    min-width: 34rem;
    border-collapse: separate;
    border-spacing: 0 6px;
    font-family: var(--police-titre);
    font-size: 1.15rem;
  }

  .carte-prix thead th {
    padding: 0.7rem 1rem;
    background: var(--noir);
    color: var(--blanc);
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-align: center;
    text-transform: uppercase;
  }

  .carte-prix thead th:first-child {
    text-align: start;
  }

  .carte-prix__boite {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
  }

  .carte-prix__boite :global(svg) {
    width: 1.3em;
    height: 1.3em;
  }

  .carte-prix__prnd {
    font-size: 0.8em;
    letter-spacing: 0.04em;
  }

  .carte-prix tbody th {
    padding: 0.55rem 1rem;
    font-weight: 600;
    text-align: start;
    background: var(--blanc);
    color: var(--encre);
  }

  .carte-prix tbody tr:nth-child(even) th {
    background: var(--noir);
    color: var(--blanc);
  }

  .carte-prix__prix {
    width: 9rem;
    padding: 0.55rem 1rem;
    background: var(--petrole-fonce);
    color: var(--blanc);
    font-size: 1.3rem;
    font-weight: 700;
    text-align: center;
    white-space: nowrap;
    border-inline-start: 6px solid var(--gris);
  }

  .explications {
    display: grid;
    gap: var(--e-6);
    list-style: none;
  }

  .explications li {
    display: grid;
    gap: var(--e-3);
    align-content: start;
    justify-items: start;
  }

  .explications__pastille {
    --taille: 3.6rem;
    margin: 0.4rem 0 var(--e-2) 0.4rem;
  }

  .explications h3 {
    font-size: 1.35rem;
  }

  .explications p {
    color: var(--texte-doux);
  }

  @media (min-width: 40rem) {
    .groupe__formules,
    .autres,
    .explications {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .groupe__formules--3,
    .autres {
      grid-template-columns: repeat(3, 1fr);
    }

    .explications {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
